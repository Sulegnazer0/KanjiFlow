      "title": "2. Hiragana: T/N/H",
      "description": "Continue with the T, N, and H rows."
    },
    "hira-basic-3": {
      "title": "3. Hiragana: M/Y/R/W",
      "description": "Complete the basic gojūon and ん."
    },
    "hira-voiced": {
      "title": "4. Hiragana with dakuten",
      "description": "Practice the G, Z, D, B, and P sounds."
    },
    "hira-combinations": {
      "title": "5. Combined hiragana",
      "description": "Sounds with small ゃ・ゅ・ょ: きゃ, しゅ, ちょ…"
    },
    "kata-basic-1": {
      "title": "6. Katakana: vowels and K/S",
      "description": "Learn the katakana forms of the first rows."
    },
    "kata-basic-2": {
      "title": "7. Katakana: T/N/H",
      "description": "Continue with the T, N, and H rows."
    },
    "kata-basic-3": {
      "title": "8. Katakana: M/Y/R/W",
      "description": "Complete the basic katakana syllabary."
    },
    "kata-voiced": {
      "title": "9. Katakana with dakuten",
      "description": "Practice the G, Z, D, B, and P sounds in katakana."
    },
    "kata-combinations": {
      "title": "10. Combined katakana",
      "description": "Common combinations in foreign loanwords."
    },
    "kana-special": {
      "title": "11. Special kana rules",
      "description": "っ/ッ double consonants; ー lengthens vowels and ヴ represents the “v” sound."
    },
